# Production/real-device API URL.
# Overrides the dev fallback (Android emulator -> http://10.0.2.2:8080, iOS simulator -> http://localhost:8080).
# Example: EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_URL=

# Backend base URL without a trailing slash. The locale and /api/v1 suffix are
# appended automatically (see src/config.js). Production: https://proleadly.com/astrology
EXPO_PUBLIC_API_URL=

# Default app locale. Single source of truth for the initial UI language and
# the backend locale prefix (English -> /api/v1, Russian -> /ru/api/v1).
# 'ru' -> Russian store build (Russian UI and interpretation texts).
# 'en' -> Google Play build (English UI and texts).
EXPO_PUBLIC_LOCALE=ru

# Google OAuth Web client ID ("Web application" type in Google Cloud Console).
# Used by @react-native-google-signin/google-signin (webClientId) and must match
# the backend GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
